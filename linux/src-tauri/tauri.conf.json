{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FERI Dashboard",
  "version": "0.1.0",
  "identifier": "si.tadej.feri-dashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FERI Dashboard",
        "visible": false,
        "width": 1360,
        "height": 860,
        "minWidth": 920,
        "minHeight": 620
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis"],
    "category": "Education",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
